{
  "name": "logic-lab-leaderboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "check:api-doc": "node scripts/check-api-doc.mjs",
    "verify": "npm run typecheck && npm run check:api-doc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.127.1"
  }
}
